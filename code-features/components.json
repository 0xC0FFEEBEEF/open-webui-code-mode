[
 {
  "name": "desktop-cli",
  "label": "Desktop tool",
  "branch": "master",
  "test": [
   "{venv}/bin/python",
   "-m",
   "pytest",
   "-q",
   "-p",
   "no:cacheprovider"
  ],
