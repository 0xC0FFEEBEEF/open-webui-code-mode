[Unit]
Description=code-previews: forwards /previews/<chat id>/ to a Code chat's preview, for the chat's owner
After=network.target openwebui.service

[Service]
User=owui
Group=owui
ExecStart=/usr/bin/python3 /home/owui/.local/lib/code-previews/code-previews.py
# port 80, and nothing else
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
Restart=always
RestartSec=1
MemoryMax=64M

[Install]
WantedBy=multi-user.target
