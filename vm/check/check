#!/usr/bin/env python3
"""check - read a project's code and report what would break, before anyone runs it.

    check                 the whole project (the git root, else this folder)
    check FILE_OR_DIR...  the same checks, showing only the findings in those paths

It ends with `CHECK: PASS` or `CHECK: FAIL` (exit 1). ERRORS are things that will break when the code runs:
undefined names, syntax errors, files a page links to that don't exist, an element id the code needs that no page
has. WARNINGS are likely mistakes to look at one by one. It reads code; it never runs it and never changes a file.

Web pages are checked the way a browser loads them: every script a page loads (files and inline <script> blocks)
shares its globals, inline `onclick=...` handlers are checked against them, and a script that no page loads is
checked as a Node.js file. If a name really is a global from a library, say so in that file: /* global Name */
"""
import difflib
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.parse
from html.parser import HTMLParser

HOME = os.environ.get("CODE_CHECK_HOME", "/opt/code-check")
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "env", "__pycache__", "dist", "build", ".next", ".cache",
             ".pytest_cache", ".mypy_cache", ".ruff_cache", "site-packages", "coverage", ".idea", ".vscode"}
VENDOR_DIRS = {"vendor", "vendors", "third_party", "third-party", "lib", "libs"}
MAX_BYTES = 600_000
MAX_ERRORS, MAX_WARNINGS = 40, 25

