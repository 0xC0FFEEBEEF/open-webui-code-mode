def cmd_delegate(api, session, token, task, max_steps):
    """Let the vision model drive the desktop to do TASK, then report."""
    history = []
    last_sig = None
    repeats = 0
    bad = 0
    first_call = True
    exit_code = EXIT_API
    reason = ""
    report = ""
    step = 0
    try:
        while step < max_steps:
            step += 1
            obs = capture_view(api, session, token)
            elements = {e["id"]: e for e in (obs.get("elements") or [])
                        if isinstance(e, dict) and isinstance(e.get("id"), int)}
            title = obs.get("title") or ""
            url = obs.get("url") or ""
            page_text = (obs.get("text") or "")[:PAGE_TEXT_LIMIT]
            image_b64 = obs.get("screenshot", "") or ""

            items = "\n".join("[%d] %s \"%s\"" % (eid, el.get("tag", ""),
                                                   (el.get("text", "") or "")[:40])
                              for eid, el in sorted(elements.items())) or "(no clickable elements)"
            what = "\n".join("- " + h for h in history) or "(nothing yet)"
            done_example = ('{"thought": "...", "action": "done", '
                            '"report": "what you did, what you saw, what looks wrong"}')
            user_text = ("TASK: " + task +
                         "\n\nWhat you have done so far:\n" + what +
                         "\n\nCurrent page: " + title + " — " + url +
                         "\n\nPage text:\n" + page_text +
                         "\n\nClickable elements:\n" + items +
                         "\n\nReply with ONE JSON action to make progress. Prefer clicking an element "
                         "by number." +
                         "\nWhen the task is finished, reply with: " + done_example)

            raw = ask_vision(VISION_MODEL, DELEGATE_SYSTEM_PROMPT,
                             user_text, image_b64,
                             response_format=DELEGATE_ACTION_SCHEMA, first=first_call)
            first_call = False

            action = parse_vision_action(raw)
            if action is None:
                bad += 1
                history.append("your last reply was not a usable JSON action - reply with exactly one JSON object")
                print("step %d: (no usable action)" % step)
                if bad >= DELEGATE_BAD_LIMIT:
                    reason = "%d unparseable replies in a row" % DELEGATE_BAD_LIMIT
                    break
                continue
            bad = 0

            sig = json.dumps({k: action.get(k) for k in ("action", "id", "x", "y",
                                   "url", "text", "keys", "direction", "enter")}, sort_keys=True)
            if sig == last_sig:
                repeats += 1
            else:
                repeats = 1
                last_sig = sig
            if repeats >= DELEGATE_REPEAT_LIMIT:
                label = describe_delegate_action(action, elements)
                history.append('%s -> REFUSED: you did exactly this %d times already and it did not '
                               "help. Do something different." % (label, DELEGATE_REPEAT_LIMIT))
                print("step %d: (refused repeat: %s)" % (step, label))
                continue

            block = _blocked_delegate(action, elements)
            if block:
                label = describe_delegate_action(action, elements)
                history.append("%s -> REFUSED: %s" % (label, block))
                print("step %d: (refused: %s)" % (step, block))
                continue

            label = describe_delegate_action(action, elements)
            if action.get("action") == "done":
                report = str(action.get("report") or "").strip()
                history.append("done: %s" % report)
                print("step %d: %s" % (step, label))
                exit_code = EXIT_OK
                break

            act = translate_delegate_action(action, obs)
            code = delegate_act(api, session, token, act, "vision agent: " + label)
            if code != EXIT_OK:
                exit_code = EXIT_API
                reason = "the desktop rejected an action" if code == EXIT_API else "the desktop is under user control"
                break
            history.append("%s -> ok" % label)
            print("step %d: %s" % (step, label))
    except ApiError as e:
        print("desktop: %s" % e, file=sys.stderr)
        exit_code = EXIT_API
        reason = str(e)
    finally:
        caption(api, session, "", False, token)

    print()
    print("Desktop session: %s" % session)
    print("Vision model: %s" % VISION_MODEL)
    print("Steps: %d" % step)
    print("Report:")
    if exit_code == EXIT_OK:
        print(report or "(no report)")
    else:
        if not reason:
            reason = "the step limit was reached"
        print("(stopped before finishing: %s)" % reason)
    return exit_code


# ---- errors and verify (2026-10-09) ---------------------------------------
# Agents kept calling pages "working" that weren't: a script that never ran, blocked map tiles, a black
# satellite layer, a page served from the browser cache. `errors` shows what the browser recorded for the
# page; `verify` reloads it fresh and gives a verdict an agent can't talk its way past.

DIAG_TIMEOUT = 60
VERIFY_SETTLE = 20            # seconds to wait for the page to stop loading
IMAGE_FAIL_SHARE = 0.10       # a few missing tiles is normal; more than this share of images failing is not
BROKEN_TEXT_RE = re.compile(r"(?<![\w-])(undefined|NaN|\[object Object\])(?![\w-])")

VERIFY_SYSTEM_PROMPT = """You are a strict QA reviewer. You get a screenshot of a web app that a developer says is
finished, plus its visible text. You have not seen their code or their claims. Report only problems you can actually
see: blank, black or grey areas where content should be; error messages; "API key required", "access blocked" or
watermark text over maps or images; placeholder, sample or demo data; spinners or "Loading..." that never finished;
overlapping, cut-off or unreadable text; empty lists, charts or maps. Do not invent problems and do not judge taste."""

VERIFY_SCHEMA = {"type": "json_schema", "json_schema": {"name": "review", "strict": True, "schema": {
    "type": "object", "additionalProperties": False, "required": ["broken", "problems", "missing"],
    "properties": {"broken": {"type": "boolean"},
                   "problems": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 8},
                   "missing": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 8}}}}}


def diag(api, session, token, settle=0, full=True):
    status, data = _request(api, session, "POST", "/api/diag", body={"settle": settle, "full": full},
                            token=token, timeout=DIAG_TIMEOUT)
    if status != 200:
        raise ApiError(_http_message("diag", status, data))
    return data


def cmd_errors(api, session, token):
    d = diag(api, session, token)
    print("Desktop session: %s" % session)
    log = d.get("log")
    if not d.get("url"):
        print("No page is open.")
        return EXIT_OK
    if not log:
        print("Page: %s — %s" % (d.get("title") or "", d.get("url")))
        print("Nothing recorded for this tab%s." % ("" if d.get("watching") else
                                                   " (the desktop is not recording page errors - report-bug it)"))
        return EXIT_OK
    kinds = ", ".join("%d %s" % (n, t) for t, n in sorted((log.get("by_type") or {}).items(), key=lambda x: -x[1]))
    print("Page: %s — %s" % (d.get("title") or "", log.get("url") or d.get("url")))
    print("Loaded %ss ago; %s (%s)%s" % (log.get("age_s"), _plural(log.get("requests", 0), "request"), kinds or "none",
                                          ", %d still loading" % log["pending"] if log.get("pending") else ""))
    print()
    errors, cons, failed = log.get("errors") or [], log.get("console_errors") or [], log.get("failed") or []
    if not (errors or cons or failed):
        print("No JavaScript errors, console errors or failed requests since this page loaded.")
    if errors:
        print("JavaScript errors (uncaught):")
        for i, e in enumerate(errors, 1):
            print("  %d. %s" % (i, e.get("text", "").strip().replace("\n", "\n     ")))
            if e.get("where") and e["where"] not in (e.get("text") or ""):
                print("     at %s" % e["where"])
    if cons:
        print("Console errors:")
        for c in cons:
            print("  - [%s] %s%s" % (c.get("type"), c.get("text", ""), (" (%s)" % c["where"]) if c.get("where") else ""))
    if failed:
        print("Failed requests:")
        for f in failed:
            print("  - %s %s %s" % (f.get("status") or f.get("error") or "failed", f.get("type", ""), f.get("url", "")))
    recent = log.get("recent") or []
    if recent:
        print()
        print("Latest console messages:")
        for r in recent[-15:]:
            print("  [%s] %s" % (r.get("type"), r.get("text", "")))
    return EXIT_OK


def loaded_vision_model(api):
    """The router's loaded model when it can see (VISION_MODELS), else None. An explicit VISION_MODEL wins."""
    if os.environ.get(VISION_MODEL_ENV):
        return os.environ[VISION_MODEL_ENV]
    chosen = prefer_loaded_vision_model(api, None)
    return chosen or None


def judge(log, text, settled, elements):
    """Mechanical verdict on a freshly loaded page: (problems, warnings)."""
    problems, warnings = [], []
    if log is None:
        problems.append("the desktop recorded nothing for this page, so errors can't be checked (report-bug it)")
        return problems, warnings
    for e in log.get("errors") or []:
        first = (e.get("text") or "").strip().splitlines()[0] if (e.get("text") or "").strip() else "error"
        problems.append("JavaScript error: %s%s" % (first[:200], (" (%s)" % e["where"]) if e.get("where") else ""))
    for c in log.get("console_errors") or []:
        problems.append("Console error: %s" % (c.get("text") or "")[:200])
    failed = [f for f in log.get("failed") or [] if not (f.get("url") or "").split("?")[0].endswith("/favicon.ico")]
    images = [f for f in failed if f.get("type") == "Image"]
    others = [f for f in failed if f.get("type") != "Image"]
    for f in others[:8]:
        problems.append("Request failed: %s %s %s" % (f.get("status") or f.get("error") or "failed",
                                                      f.get("type", ""), (f.get("url") or "")[:160]))
    if len(others) > 8:
        problems.append("... and %d more failed requests (desktop errors)" % (len(others) - 8))
    if images:
        total = max(1, (log.get("by_type") or {}).get("Image", len(images)))
        eg = "%s %s" % (images[0].get("status") or images[0].get("error"), (images[0].get("url") or "")[:140])
        msg = "%d of %d images failed to load (e.g. %s)" % (len(images), total, eg)
        (problems if len(images) / total > IMAGE_FAIL_SHARE or len(images) >= 5 else warnings).append(msg)
    if not settled:
        warnings.append("the page was still loading after %d s (%d requests pending)" % (VERIFY_SETTLE, log.get("pending", 0)))
    shown = (text or "").strip()
    m = BROKEN_TEXT_RE.search(shown)
    if m:
        a = max(0, m.start() - 50)
        problems.append('the page shows "%s": ...%s...' % (m.group(1), shown[a:m.end() + 50].replace("\n", " ")))
    if len(shown) < 20 and not elements:
        problems.append("the page is blank (no visible text and nothing to click)")
    return problems, warnings


def review(model, obs, expect):
    """The vision model's independent look at the screenshot: (problems, missing, note)."""
    user = "Page: %s — %s\n\nVisible text:\n%s\n\n" % (obs.get("title") or "", obs.get("url") or "",
                                                      (obs.get("text") or "")[:PAGE_TEXT_LIMIT])
    if expect:
        user += "The page should show:\n%s\nFor each item, check you can actually see it.\n\n" % expect
    user += 'Reply with JSON only: {"broken": true|false, "problems": ["..."], "missing": ["expected items you cannot see"]}'
    raw = ask_vision(model, VERIFY_SYSTEM_PROMPT, user, obs.get("screenshot") or "", response_format=VERIFY_SCHEMA,
                     first=True)
    text = re.sub(r"^```(?:json)?\s*|\s*```$", "", strip_think(raw), flags=re.M).strip()
    try:
        got = json.loads(text[text.find("{"):text.rfind("}") + 1])
    except (ValueError, TypeError):
        return [], [], "the vision check gave no usable answer"
    problems = [str(p) for p in got.get("problems") or [] if str(p).strip()]
    missing = [str(p) for p in got.get("missing") or [] if str(p).strip()]
    if got.get("broken") and not problems and not missing:
        problems = ["the reviewer says the page looks broken"]
    return problems, missing, ""


PREVIEW_ORIGIN_ENV = "DESKTOP_PREVIEW_ORIGIN"
DEFAULT_PREVIEW_ORIGIN = "http://127.0.0.1:4097"          # the preview server, as the desktop reaches it
PREVIEW_STATE_DIR = os.path.expanduser("~/.local/state/code-mode/preview")   # written by Code mode each turn


def preview_url(session, url):
    """The app the way the user's Preview panel shows it: through the preview server (its browser rules; it passes
    requests to a server started from the project folder). None when this desktop isn't a Code chat's."""
    try:
        with open(os.path.join(os.environ.get("DESKTOP_PREVIEW_STATE", PREVIEW_STATE_DIR), session)) as fh:
            path = fh.read().strip()
    except OSError:
        return None
    if not re.fullmatch(r"/p/[A-Za-z0-9_-]+/[0-9a-f]{32}/", path):
        return None
    rest = ""
    if url:
        sp = urllib.parse.urlsplit(url)
        # given the Preview's own address (/p/<chat>/<sig>/...), keep only the part inside the app
        inner = re.sub(r"^/p/[^/]+/[^/]*/?", "", sp.path) if sp.path.startswith("/p/") else sp.path
        rest = inner.lstrip("/") + ("?" + sp.query if sp.query else "")
    return os.environ.get(PREVIEW_ORIGIN_ENV, DEFAULT_PREVIEW_ORIGIN).rstrip("/") + path + rest


def cmd_verify(api, session, token, url, expect, force_vision, here=False, direct=False):
    """Load the page fresh, let it settle, then check it: errors, failed requests, visible text, and a vision
    model's independent look at the screenshot. Prints VERIFY: PASS or VERIFY: FAIL. With here=True the page is
    checked as it is now (after clicks), not reloaded: errors since it loaded, and the current screen."""
    if here and url:
        print("desktop: verify --here checks the page as it is now; give no URL", file=sys.stderr)
        return EXIT_BAD
    if url and "://" not in url:
        url = "http://" + url          # "localhost:8000"; the browser would otherwise try https
    via = None if (here or direct) else preview_url(session, url)
    if not here:
        target = via or url
        action = {"action": "navigate", "url": target} if target else {"action": "reload"}
        code = delegate_act(api, session, token, action, "opencode: verify " + (target or "the page"))
        if code != EXIT_OK:
            return code
    d = diag(api, session, token, settle=VERIFY_SETTLE)
    if not d.get("watching"):
        print("VERIFY: FAIL - can't check")
        print("The desktop is not recording page errors, so this page can't be verified. That is a tool problem:")
        print('report-bug "desktop verify: page errors are not recorded" "<what you ran and saw>"')
        return EXIT_VERIFY_FAIL
    status, obs = _request(api, session, "POST", "/api/observe", body={"marks": False, "max_width": SCREENSHOT_MAX_WIDTH},
                           token=token, timeout=OBSERVE_TIMEOUT)
    if status != 200:
        raise ApiError(_http_message("observe", status, obs))
    log = d.get("log")
    problems, warnings = judge(log, obs.get("text") or "", d.get("settled"), obs.get("elements") or [])
    model = loaded_vision_model(VISION_API) or (VISION_MODEL if force_vision else None)
    seen = ""
    if model:
        try:
            vp, vm, note = review(model, obs, expect)
        except ApiError as e:
            vp, vm, note = [], [], "the vision check failed: %s" % e
        problems += ["Looks wrong: %s" % p for p in vp] + ["Not visible: %s" % m for m in vm]
        if note:
            warnings.append(note)
        seen = "screenshot reviewed by %s%s" % (model, " against: " + expect if expect else "")
    else:
        warnings.append("no vision model is loaded, so nobody looked at the screenshot: read `desktop screenshot "
                        "shot.png` yourself, or rerun with --vision (loads one: minutes)")
    print("VERIFY%s: %s" % (" (as it is now, not reloaded)" if here else "",
                             "PASS" if not problems else "FAIL - %s" % _plural(len(problems), "problem")))
    print("Page: %s — %s" % (obs.get("title") or "", obs.get("url") or (log or {}).get("url") or ""))
    if via:
        print("Loaded the way the user's Preview panel shows it: through the preview server (its browser rules), "
              "which passes requests to your server when it runs from this project folder.")
    if log:
        print("%s: %s, %d failed" % ("Since it loaded" if here else "Loaded fresh (no cache)",
                                     _plural(log.get("requests", 0), "request"), len(log.get("failed") or [])))
    if problems:
        print("Problems:")
        for i, p in enumerate(problems, 1):
            print("  %d. %s" % (i, p))
    if warnings:
        print("Warnings:")
        for w in warnings:
            print("  - %s" % w)
    print("Checked: JavaScript errors, console errors, failed requests, visible text%s." % ("; " + seen if seen else ""))
    if via and log:
        # A path with a leading slash ("/api/x") leaves the app's folder in the Preview, which serves the app under
        # /p/<chat>/<sig>/: name that plainly (an agent took it for a broken preview server, 2026-10-09).
        sp = urllib.parse.urlsplit(via)
        origin, prefix = "%s://%s" % (sp.scheme, sp.netloc), sp.path[:sp.path.find("/", sp.path.find("/", 3) + 1) + 1]
        escaped = sorted({urllib.parse.urlsplit(f.get("url") or "").path for f in log.get("failed") or []
                          if (f.get("url") or "").startswith(origin + "/") and
                          not urllib.parse.urlsplit(f.get("url") or "").path.startswith(prefix)})
        if escaped:
            print("Why some requests failed: %s start%s with \"/\", so in the user's Preview they leave your app's folder "
                  "(the Preview serves your app under %s) and reach nothing. Your server is fine. Use relative paths "
                  "instead, with no leading slash: fetch(\"%s\"), src=\"app.js\", href=\"styles.css\"; the Preview then "
                  "passes them to your server." % (", ".join(escaped[:4]), "s" if len(escaped) == 1 else "",
                                                   prefix, escaped[0].lstrip("/")))
    if problems:
        print("Fix these and run `desktop verify` again. Don't hide errors, swallow exceptions or add fallback/demo "
              "data to make it pass. `desktop errors` shows the details.")
        if any(p.startswith("Not visible: ") for p in problems) and not here:
            print("If something only appears after an action (a details panel after a click), keep it in the list: "
                  "get there with `desktop click`, then check it with `desktop verify --here --expect \"...\"`.")
        return EXIT_VERIFY_FAIL
    return EXIT_OK


# ---- CLI -----------------------------------------------------------------
def build_parser():
    epilog = ("Element numbers come from the most recent page shown.\n"
              "To test your own web app, start it in the background "
              "(e.g. `python3 -m http.server 8000 &`) and run "
              "`desktop open http://localhost:8000`.")
    p = argparse.ArgumentParser(
        prog="desktop",
        description="Let a coding agent test web apps on a real desktop.",
        epilog=epilog,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True, metavar="<command>")

    sub.add_parser("look", help="show the page")

    p_open = sub.add_parser("open", help="open URL in the browser, then show the page")
    p_open.add_argument("url")
    p_open.add_argument("--new-tab", action="store_true")

    p_click = sub.add_parser("click", help="click element N from the last page shown, then show the page")
    p_click.add_argument("n", type=int)

    p_type = sub.add_parser("type", help="type into element N (or the focused element), then show the page")
    p_type.add_argument("n", nargs="?", type=int, default=None)
    p_type.add_argument("text")
    p_type.add_argument("--enter", action="store_true")
    p_type.add_argument("--no-clear", action="store_true")

    p_key = sub.add_parser("key", help="press keys, e.g. Enter, Tab, ctrl+a")
    p_key.add_argument("keys")

    p_scroll = sub.add_parser("scroll", help="scroll up or down (default: down 5)")
    p_scroll.add_argument("direction", nargs="?", choices=["up", "down"], default="down")
    p_scroll.add_argument("amount", nargs="?", type=int, default=5)

    sub.add_parser("back", help="browser back")

    p_wait = sub.add_parser("wait", help="wait then show the page (max 10s)")
    p_wait.add_argument("seconds", nargs="?", type=int, default=None)

    p_hover = sub.add_parser("hover", help="hover over element N from the last page shown, or --xy X Y (screen pixels)")
    p_hover.add_argument("n", nargs="?", type=int, default=None)
    p_hover.add_argument("--xy", nargs=2, type=int, metavar=("X", "Y"))

    p_shot = sub.add_parser("screenshot", help="save a full-size screenshot with element numbers")
    p_shot.add_argument("file")

    p_up = sub.add_parser("upload", help="attach files to a file upload: upload [N] FILE... (N = the upload button "
                                         "or field; default: the page's only file input), then show the page")
    p_up.add_argument("items", nargs="+", metavar="[N] FILE")

    sub.add_parser("status", help="print the session name and whether the user has control")
    sub.add_parser("done", help="shut this session's desktop down to free memory")

    p_see = sub.add_parser("see", help="ask the vision model what it sees on the current page")
    p_see.add_argument("question")

    p_deg = sub.add_parser("delegate", help="let the vision model drive the desktop to do a task")
    p_deg.add_argument("task")
    p_deg.add_argument("--steps", type=int, default=None)

    sub.add_parser("errors", help="JavaScript errors, console output and failed requests since the page loaded")

    p_ver = sub.add_parser("verify", help="load the page fresh and check it: prints VERIFY: PASS or FAIL")
    p_ver.add_argument("url", nargs="?", default=None, help="your app's address (default: reload the current page)")
    p_ver.add_argument("--expect", default="", help='what the page must show, e.g. "a map of the Gulf, a list of storms"')
    p_ver.add_argument("--vision", action="store_true", help="load a vision model if none is loaded (minutes)")
    p_ver.add_argument("--here", action="store_true",
                       help="check the page as it is now (after clicks), without reloading")
    p_ver.add_argument("--direct", action="store_true",
                       help="load URL itself instead of through the user's Preview (debugging only)")

    return p


def main(argv):
    args = build_parser().parse_args(argv)
    api, token = load_credentials()
    session = resolve_session()
    global VISION_API, VISION_MODEL
    VISION_API, VISION_MODEL = load_vision_config()
    VISION_MODEL = prefer_loaded_vision_model(VISION_API, VISION_MODEL)
    try:
        if args.command == "look":
            return cmd_look(api, session, token)
        if args.command == "screenshot":
            return cmd_screenshot(api, session, token, args.file)
        if args.command == "status":
            return cmd_status(api, session, token)
        if args.command == "done":
            return cmd_done(api, session, token)
        if args.command == "see":
            return cmd_see(api, session, token, args.question)
        if args.command == "errors":
            return cmd_errors(api, session, token)
        if args.command == "upload":
            return cmd_upload(api, session, token, args.items)
        if args.command == "verify":
            return cmd_verify(api, session, token, args.url, args.expect, args.vision, args.here, args.direct)
        if args.command == "delegate":
            steps = args.steps
            if steps is None:
                steps = _int_env(DELEGATE_STEPS_ENV, DELEGATE_DEFAULT_STEPS)
            if steps < 1:
                print("desktop: --steps must be at least 1", file=sys.stderr)
                return EXIT_BAD
            return cmd_delegate(api, session, token, args.task, steps)
        action, desc = build_action(args)
        return do_act(api, session, token, action, desc)
    except ApiError as e:
        print("desktop: %s" % e, file=sys.stderr)
        return EXIT_API


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
