#!/usr/bin/env python3
"""desktop -- let a coding agent test web apps on a real desktop.

One file, Python 3.12 standard library only. Talks to the Code Mode desktop
API (POST /api/observe, POST /api/act, POST /api/caption, GET /health).
"""

import argparse
import base64
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# ---- constants -----------------------------------------------------------
DEFAULT_API = "http://127.0.0.1:6080"
ENV_FILE = "/etc/code-mode/desktop.env"

OBSERVE_TIMEOUT = 90      # seconds; first request for a new session is slow
ACT_TIMEOUT = 90
HEALTH_TIMEOUT = 10

POLL_ENV = "DESKTOP_POLL"
MAX_WAIT_ENV = "DESKTOP_WAIT_MAX"
ENV_FILE_ENV = "DESKTOP_ENV_FILE"

DEFAULT_POLL = 2.0
DEFAULT_MAX_WAIT = 300.0

SESSION_MAX = 64
SHOW_LIMIT = 60
TEXT_LIMIT = 2000
ELEMENT_TEXT_LIMIT = 80
UPLOAD_MAX_BYTES = 50 * 2**20   # all files of one upload together (the desktop API's limit too)
UPLOAD_TIMEOUT = 120

SAFE_PREFIX = "/home/coder/projects/chats/"
FEATURES_PREFIX = "/home/coder/projects/features/"

# Exit codes
EXIT_OK = 0
EXIT_API = 1
EXIT_BAD = 2
EXIT_USERCONTROL = 3
EXIT_VERIFY_FAIL = 4


class ApiError(Exception):
    """A connection-level failure (not an HTTP error response)."""


# ---- credentials ---------------------------------------------------------
def _read_env_file(path):
    data = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, val = line.split("=", 1)
                key = key.strip()
                val = val.strip()
                if len(val) >= 2 and val[0] in "\"'" and val[-1] == val[0]:
                    val = val[1:-1]
                data[key] = val
    except OSError:
        pass
    return data


def load_credentials():
    """Return (api_base, token). Never prints the token."""
    api = os.environ.get("DESKTOP_API")
    token = os.environ.get("CONTROL_TOKEN")
    env_file = os.environ.get(ENV_FILE_ENV, ENV_FILE)
    if not api or not token:
        filevars = _read_env_file(env_file)
        api = api or filevars.get("DESKTOP_API") or DEFAULT_API
        token = token or filevars.get("CONTROL_TOKEN")
    if not token:
        print("desktop: no control token found; set CONTROL_TOKEN or add it "
              "to %s" % ENV_FILE, file=sys.stderr)
        sys.exit(EXIT_API)
    return api, token


# ---- session selection ---------------------------------------------------
def _sanitize(name):
    name = re.sub(r"[^A-Za-z0-9_-]", "", name)
    return name[:SESSION_MAX]


def _git_root(start):
    d = os.path.abspath(start)
    while True:
        if os.path.isdir(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def resolve_session():
    """Work out which desktop session to use, then validate it."""
    if "CODE_DESKTOP" in os.environ:
        raw = os.environ["CODE_DESKTOP"]
    else:
        cwd = os.path.abspath(os.getcwd())
        if cwd.startswith(SAFE_PREFIX):
            raw = cwd[len(SAFE_PREFIX):].split("/")[0]
        elif cwd.startswith(FEATURES_PREFIX):
            raw = cwd[len(FEATURES_PREFIX):].split("/")[0]
        else:
            root = _git_root(cwd) or cwd
            raw = "code-" + os.path.basename(root.rstrip("/"))
    name = _sanitize(raw)
    if not name or name == "default":
        print("desktop: refusing to use desktop session %r "
              "(it is the empty string or 'default')" % (name or "<empty>"),
              file=sys.stderr)
        sys.exit(EXIT_BAD)
    return name


# ---- HTTP ----------------------------------------------------------------
def _request(api, session, method, path, body=None, token=None, timeout=None):
    url = "%s%s?%s" % (api, path, urllib.parse.urlencode({"s": session}))
    headers = {"Content-Type": "application/json"}
    if token is not None:
        headers["Authorization"] = "Bearer %s" % token
    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status = resp.status
            raw = resp.read()
    except urllib.error.HTTPError as e:
        status = e.code
        raw = e.read()
    except urllib.error.URLError as e:
        raise ApiError("cannot reach desktop API at %s: %s" % (url, e.reason))
    except (TimeoutError, OSError) as e:
        raise ApiError(str(e))
    try:
        parsed = json.loads(raw.decode("utf-8")) if raw.strip() else {}
    except json.JSONDecodeError:
        parsed = {}
    return status, parsed


def _error_detail(body):
    """Extract human-readable error text from a server error response.

    The desktop API answers errors as {"error": "..."} while FastAPI answers
    as {"detail": "..."}; prefer "detail", fall back to "error".
    """
    if isinstance(body, dict):
        if body.get("detail"):
            return str(body["detail"])
        if body.get("error"):
            return str(body["error"])
    return ""


def _http_message(verb, status, body):
    """Build an error message for a non-200 response, including the server's reason."""
    msg = "%s: HTTP %s" % (verb, status)
    detail = _error_detail(body)
    if detail:
        msg += " (%s)" % detail
    return msg


def _float_env(name, default):
    try:
        return float(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default


def _int_env(name, default):
    try:
        return int(os.environ.get(name, default))
    except (TypeError, ValueError):
        return default


def caption(api, session, text, busy, token):
    """Show a caption in the user's live viewer. Ignore failures."""
    try:
        _request(api, session, "POST", "/api/caption",
                 body={"text": text, "busy": busy}, token=token,
                 timeout=HEALTH_TIMEOUT)
    except ApiError:
        pass


def health_user_control(api, session):
    try:
        _, body = _request(api, session, "GET", "/health", token=None,
                           timeout=HEALTH_TIMEOUT)
    except ApiError:
        return False
    return bool(body.get("user_control", False))


def wait_for_handback(api, session):
    """Wait for the user to release the desktop. Returns True if released."""
    print("The user has control of the desktop; waiting for them to hand it "
          "back...")
    poll = _float_env(POLL_ENV, DEFAULT_POLL)
    max_wait = _float_env(MAX_WAIT_ENV, DEFAULT_MAX_WAIT)
    start = time.monotonic()
    while time.monotonic() - start < max_wait:
        time.sleep(poll)
        if not health_user_control(api, session):
            return True
    return False


def observe(api, session, token, marks=False):
    body = {"marks": marks}
    if not marks:
        body["max_width"] = 320
    status, data = _request(api, session, "POST", "/api/observe", body=body,
                            token=token, timeout=OBSERVE_TIMEOUT)
    if status != 200:
        raise ApiError(_http_message("observe", status, data))
    return data


# ---- output --------------------------------------------------------------
def _plural(n, word):
    return "%d %s%s" % (n, word, "" if n == 1 else "s")


def problems_line(data):
    """One line on what the page did wrong since it loaded (the desktop API records it per tab): uncaught
    JavaScript errors, console errors and failed requests - what page text and screenshots can't show."""
    d = data.get("diag")
    if d is None:
        if data.get("watching") is False:
            return "Page problems: unknown (the desktop is not recording this tab)"
        return "Page problems: none recorded" if data.get("watching") else ""
    c = d.get("counts") or {}
    parts = []
    if c.get("errors"):
        parts.append(_plural(c["errors"], "JavaScript error"))
    if c.get("console_errors"):
        parts.append(_plural(c["console_errors"], "console error"))
    if c.get("failed"):
        parts.append(_plural(c["failed"], "failed request"))
    if not parts:
        return "Page problems since it loaded: none (no JavaScript errors, console errors or failed requests)"
    lines = ["Page problems since it loaded: %s. Run `desktop errors` for details." % ", ".join(parts)]
    lines += ["  - %s" % f for f in (d.get("first") or [])[:3]]
    return "\n".join(lines)


def print_page(session, data):
    print("Desktop session: %s" % session)
    url = data.get("url")
    title = data.get("title") or ""
    if url:
        print("Page: %s — %s" % (title, url))
    else:
        print("Page: (no page open)")
    tabs = data.get("tabs") or []
    print("Tabs open: %d" % len(tabs))
    line = problems_line(data) if url else ""
    if line:
        print(line)
    if data.get("file_dialog"):
        print("Chrome's file picker is open. You can't use it (it is not part of the page): attach files with "
              "`desktop upload N FILE`, which closes it.")
    print()
    print("Page text:")
    text = data.get("text") or ""
    if text.strip():
        print(text[:TEXT_LIMIT])
    else:
        print("(none)")
    print()
    print("Clickable elements (number, kind, text):")
    shown = 0
    extra = 0
    for el in data.get("elements") or []:
        if el.get("tag") == "drawn":
            continue
        if shown >= SHOW_LIMIT:
            extra += 1
            continue
        kind = el.get("tag", "")
        role = el.get("role", "")
        if role:
            kind = "%s/%s" % (kind, role)
        label = (el.get("text", "") or "")[:ELEMENT_TEXT_LIMIT]
        print("[%d] %s \"%s\"" % (el.get("id"), kind, label))
        shown += 1
    if extra:
        print("(+%d more further down; scroll to reach them)" % extra)
    if any(el.get("tag") == "input[file]" for el in data.get("elements") or []):
        print("To attach a file, run `desktop upload N FILE`; clicking a file input opens a picker you can't use.")


# ---- actions -------------------------------------------------------------
def build_action(args):
    """Return (action_dict, caption_description) for an acting command."""
    if args.command == "open":
        if args.new_tab:
            return {"action": "new_tab", "url": args.url}, "open URL"
        return {"action": "navigate", "url": args.url}, "open URL"
    if args.command == "click":
        return {"action": "click", "id": args.n}, "click element %d" % args.n
    if args.command == "type":
        act = {"action": "type", "text": args.text,
               "enter": bool(args.enter), "clear": not args.no_clear}
        if args.n is not None:
            act["id"] = args.n
        return act, "type text"
    if args.command == "key":
        return {"action": "key", "keys": args.keys}, "press keys"
    if args.command == "scroll":
        return {"action": "scroll", "direction": args.direction,
                "amount": args.amount}, "scroll %s" % args.direction
    if args.command == "back":
        return {"action": "back"}, "go back"
    if args.command == "wait":
        secs = args.seconds if args.seconds is not None else 1
        if secs < 0:
            secs = 0
        if secs > 10:
            secs = 10
        return {"action": "wait", "seconds": secs}, "wait"
    if args.command == "hover":
        if args.xy is not None:
            return {"action": "hover", "x": args.xy[0], "y": args.xy[1]}, \
                   "hover position (%d, %d)" % (args.xy[0], args.xy[1])
        return {"action": "hover", "id": args.n}, "hover element %d" % args.n
    raise AssertionError("not an acting command: %r" % args.command)


def do_act(api, session, token, action, desc):
    # Before acting, wait out any user control.
    if health_user_control(api, session):
        if not wait_for_handback(api, session):
            return EXIT_USERCONTROL
    caption(api, session, "opencode: " + desc, True, token)
    try:
        status, data = _request(api, session, "POST", "/api/act", body=action,
                                token=token, timeout=ACT_TIMEOUT)
    except ApiError as e:
        caption(api, session, "", False, token)
        print("desktop: %s" % e, file=sys.stderr)
        return EXIT_API
    caption(api, session, "", False, token)
    if status == 409:
        if not wait_for_handback(api, session):
            return EXIT_USERCONTROL
        caption(api, session, "opencode: " + desc, True, token)
        try:
            status, data = _request(api, session, "POST", "/api/act",
                                    body=action, token=token,
                                    timeout=ACT_TIMEOUT)
        except ApiError as e:
            caption(api, session, "", False, token)
            print("desktop: %s" % e, file=sys.stderr)
            return EXIT_API
        caption(api, session, "", False, token)
        if status == 409:
            return EXIT_USERCONTROL
    if status == 400 or not isinstance(data, dict) or not data.get("ok", False):
        detail = _error_detail(data) or "action rejected"
        print("desktop: %s" % detail)
        print("run `desktop look` to see the current page")
        return EXIT_API
    data2 = observe(api, session, token)
    print_page(session, data2)
    return EXIT_OK


# ---- commands ------------------------------------------------------------
def cmd_upload(api, session, token, items):
    """`desktop upload [N] FILE...`: send the files to the desktop, which attaches them to the page's file input
    (the one at element N, or the page's only one) without Chrome's file picker. The desktop's browser can't read
    this machine's files, so their contents travel with the request."""
    ident = None
    if len(items) > 1 and items[0].isdigit() and not os.path.exists(items[0]):
        ident, items = int(items[0]), items[1:]
    files, total = [], 0
    for path in items:
        full = os.path.expanduser(path)
        if not os.path.isfile(full):
            print("desktop: no such file: %s" % path, file=sys.stderr)
            return EXIT_BAD
        try:
            with open(full, "rb") as fh:
                data = fh.read()
        except OSError as e:
            print("desktop: cannot read %s: %s" % (path, e.strerror or e), file=sys.stderr)
            return EXIT_BAD
        total += len(data)
        if total > UPLOAD_MAX_BYTES:
            print("desktop: the files add up to more than %d MB" % (UPLOAD_MAX_BYTES >> 20), file=sys.stderr)
            return EXIT_BAD
        files.append({"name": os.path.basename(full), "data": base64.b64encode(data).decode("ascii")})
    if len(files) > 20:
        print("desktop: at most 20 files at a time", file=sys.stderr)
        return EXIT_BAD
    body = {"files": files}
    if ident is not None:
        body["id"] = ident
    names = ", ".join(f["name"] for f in files)
    if health_user_control(api, session):
        if not wait_for_handback(api, session):
            return EXIT_USERCONTROL
    for attempt in (1, 2):
        caption(api, session, "opencode: attach " + names, True, token)
        try:
            status, data = _request(api, session, "POST", "/api/upload", body=body, token=token,
                                    timeout=UPLOAD_TIMEOUT)
        finally:
            caption(api, session, "", False, token)
        if status != 409:
            break
        if attempt == 2 or not wait_for_handback(api, session):
            return EXIT_USERCONTROL
    if status == 404 and not (isinstance(data, dict) and "error" in data):   # an API from before uploads
        print("desktop: this desktop API has no upload yet (it needs updating)", file=sys.stderr)
        return EXIT_API
    if status != 200 or not isinstance(data, dict) or not data.get("ok"):
        print("desktop: upload failed: %s" % (_error_detail(data) or "rejected (HTTP %d)" % status))
        print("run `desktop look` to see the current page")
        return EXIT_API
    if data.get("closed_dialogs"):
        print("Closed the file picker that was open.")
    inp = data.get("input") or {}
    where = inp.get("label") or "the file input"
    print("Attached to %s: %s" % (where, ", ".join(data.get("attached") or []) or "(nothing)"))
    if data.get("left_out"):
        print("Left out (that input takes one file): %s" % ", ".join(data["left_out"]))
    if inp.get("accept"):
        print("The input accepts: %s" % inp["accept"])
    print()
    print_page(session, observe(api, session, token))
    return EXIT_OK


def cmd_look(api, session, token):
    print_page(session, observe(api, session, token))
    return EXIT_OK


def cmd_screenshot(api, session, token, outfile):
    status, data = _request(api, session, "POST", "/api/observe",
                            body={"marks": True}, token=token,
                            timeout=OBSERVE_TIMEOUT)
    if status != 200:
        print("desktop: %s" % _http_message("screenshot", status, data),
              file=sys.stderr)
        return EXIT_API
    raw = data.get("screenshot", "")
    try:
        png = base64.b64decode(raw)
    except (ValueError, TypeError):
        print("desktop: could not decode screenshot from server",
              file=sys.stderr)
        return EXIT_API
    with open(outfile, "wb") as fh:
        fh.write(png)
    return EXIT_OK


def cmd_status(api, session, token):
    print("Desktop session: %s" % session)
    print("User control: %s" % ("true" if health_user_control(api, session)
                                else "false"))
    return EXIT_OK


def cmd_done(api, session, token):
    """Park (shut down) this session's desktop to free memory."""
    status, data = _request(api, session, "POST", "/api/park", body=None,
                            token=token, timeout=ACT_TIMEOUT)
    if status == 200:
        print("Desktop %s shut down." % session)
        return EXIT_OK
    if status == 404:
        print("No desktop running for %s." % session)
        return EXIT_OK
    print("desktop: %s" % _http_message("done", status, data), file=sys.stderr)
    return EXIT_API


