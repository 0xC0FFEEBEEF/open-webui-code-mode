VISION_API = None
VISION_MODEL = None


def load_vision_config():
    """Return (vision_api, vision_model) from the environment, else the env file, else defaults."""
    api = os.environ.get(VISION_API_ENV)
    model = os.environ.get(VISION_MODEL_ENV)
    env_file = os.environ.get(ENV_FILE_ENV, ENV_FILE)
    if not api or not model:
        filevars = _read_env_file(env_file)
        api = api or filevars.get(VISION_API_ENV) or DEFAULT_VISION_API
        model = model or filevars.get(VISION_MODEL_ENV) or DEFAULT_VISION_MODEL
    return (api or DEFAULT_VISION_API), (model or DEFAULT_VISION_MODEL)


def prefer_loaded_vision_model(api, configured):
    """The model already on the router when it can see (no model swap, the agent does its own looking);
    otherwise the configured one. An explicit VISION_MODEL in the environment always wins.
    VISION_MODELS (env or env file, comma-separated) lists the router models that can see."""
    if os.environ.get(VISION_MODEL_ENV):
        return configured
    filevars = _read_env_file(os.environ.get(ENV_FILE_ENV, ENV_FILE))
    listed = os.environ.get("VISION_MODELS") or filevars.get("VISION_MODELS") or ""
    vision = {m.strip() for m in listed.split(",") if m.strip()}
    if not vision:
        return configured
    try:
        with urllib.request.urlopen(api.rstrip("/") + "/models", timeout=5) as resp:
            models = json.load(resp).get("data") or []
    except Exception:
        return configured
    for m in models:
        if m.get("id") in vision and (m.get("slerm") or {}).get("status") in ("loaded", "loading"):
            return m["id"]
    return configured


def capture_view(api, session, token):
    """Observe the page with element marks drawn; return the observe reply (screenshot, elements, text...)."""
    status, data = _request(api, session, "POST", "/api/observe",
                            body={"marks": True, "max_width": SCREENSHOT_MAX_WIDTH},
                            token=token, timeout=OBSERVE_TIMEOUT)
    if status != 200:
        raise ApiError(_http_message("observe", status, data))
    return data


def strip_think(text):
    return re.sub(r"<think>.*?</think>", "", text or "", flags=re.S).strip()


def ask_vision(model, system_text, user_text, image_b64=None, response_format=None, first=False):
    """Ask the vision model one question; return its answer (content, else reasoning_content)."""
    if first:
        print("Asking %s (it may need a few minutes to load)..." % model)
    user_content = [{"type": "text", "text": user_text}]
    if image_b64:
        user_content.append({"type": "image_url",
                             "image_url": {"url": "data:image/png;base64," + image_b64}})
    body = {"model": model, "temperature": 0.2, "max_tokens": 1500,
            "chat_template_kwargs": {"enable_thinking": False},
            "messages": [{"role": "system", "content": system_text},
                         {"role": "user", "content": user_content}]}
    if response_format is not None:
        body["response_format"] = response_format
    url = VISION_API.rstrip("/") + "/chat/completions"
    req = urllib.request.Request(url, data=json.dumps(body).encode("utf-8"),
                                 headers={"Content-Type": "application/json"}, method="POST")
    timeout = VISION_LOAD_TIMEOUT if first else VISION_TIMEOUT
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        try:
            err_raw = e.read()
        except Exception:
            err_raw = b""
        detail = _error_detail(json.loads(err_raw.decode("utf-8")) if err_raw.strip() else {})
        msg = "the vision API at %s answered HTTP %s" % (url, e.code)
        if detail:
            msg += " (%s)" % detail
        raise ApiError(msg)
    except urllib.error.URLError as e:
        raise ApiError("cannot reach the vision API at %s: %s" % (url, e.reason))
    except (TimeoutError, OSError) as e:
        raise ApiError("cannot reach the vision API at %s: %s" % (url, e))
    try:
        parsed = json.loads(raw.decode("utf-8")) if raw.strip() else {}
    except json.JSONDecodeError:
        raise ApiError("the vision API returned an unreadable response")
    try:
        msg = parsed["choices"][0]["message"]
    except (KeyError, IndexError, TypeError):
        raise ApiError("the vision API returned no answer")
    content = msg.get("content")
    if not content:
        content = msg.get("reasoning_content") or ""
    if isinstance(content, list):
        content = "\n".join(p.get("text", "") for p in content
                            if isinstance(p, dict) and p.get("type") == "text")
    return content or ""


def parse_vision_action(raw):
    """The first balanced {...} in the model's reply that has an allowed action, or None."""
    text = strip_think(raw)
    text = re.sub(r"^```(?:json)?\s*|\s*```$", "", text, flags=re.M)
    start = text.find("{")
    while start != -1:
        depth = 0
        for i in range(start, len(text)):
            c = text[i]
            if c == "{":
                depth += 1
            elif c == "}":
                depth -= 1
                if depth == 0:
                    try:
                        obj = json.loads(text[start:i + 1])
                    except json.JSONDecodeError:
                        break
                    if isinstance(obj, dict) and obj.get("action") in (
                            "open", "click", "type", "key", "scroll", "back", "wait", "hover", "done"):
                        return obj
                    break
        start = text.find("{", start + 1)
    return None


def host_of(url):
    m = re.match(r"^[a-z]+://([^/:?#]+)", url or "", re.I)
    host = (m.group(1).lower() if m else "")
    return host[4:] if host.startswith("www.") else host


_PUBLIC_DOC = ("mdn.mozilla.net", "developer.mozilla.org", "python.org", "go.dev",
               "rust-lang.org", "w3schools.com", "web.dev", "google.dev", "doc.rs",
               "wikipedia.org")


def _is_safe_open_url(url):
    """Only localhost URLs or public documentation sites may be opened by the agent."""
    host = host_of(url)
    if not host:
        return False
    if host == "localhost" or host.startswith("127.") or host == "::1":
        return True
    return host in _PUBLIC_DOC or any(host.endswith("." + s) for s in _PUBLIC_DOC)


_SECRET_RE = re.compile(r"\b(?:\d[ -]*){16,19}\b")   # a credit-card-ish run of digits


def _blocked_delegate(action, elements):
    """A safety guard the model cannot talk its way past. Return a reason string, or ''."""
    kind = action.get("action")
    if kind == "open":
        if not _is_safe_open_url(action.get("url", "")):
            return "only localhost URLs or public documentation sites may be opened"
    if kind == "type":
        eid = action.get("id")
        if isinstance(eid, int):
            el = elements.get(eid)
            if isinstance(el, dict) and (
                    (el.get("tag") == "input" and str(el.get("type", "")).lower() == "password")
                    or str(el.get("role", "")).lower() == "password"):
                return 'typing into a password field is not allowed'
        if _SECRET_RE.search(str(action.get("text", ""))):
            return "typing card numbers or long digit strings is not allowed"
    return ""


def describe_delegate_action(action, elements):
    """A short human label for a step line, e.g. ``click [5] "Calculate"``."""
    kind = action.get("action")

    def where(prefix=""):
        i = action.get(prefix + "id")
        if isinstance(i, int):
            el = elements.get(i)
            if el and el.get("text"):
                return '[%d] "%s"' % (i, str(el["text"])[:40])
            return "[%d]" % i
        x, y = action.get(prefix + "x"), action.get(prefix + "y")
        if isinstance(x, (int, float)) and isinstance(y, (int, float)):
            return "[%.0f, %.0f]" % (x, y)
        return ""

    if kind == "open":
        return "open %s" % action.get("url", "")
    if kind == "click":
        return "click %s" % where()
    if kind == "type":
        s = 'type "%s"' % str(action.get("text", ""))[:60]
        w = where()
        if w:
            s += " into %s" % w
        if action.get("enter"):
            s += " + Enter"
        return s
    if kind == "key":
        return "press %s" % action.get("keys", "")
    if kind == "scroll":
        return "scroll %s" % action.get("direction", "down")
    if kind in ("back", "wait", "done"):
        return kind
    if kind == "hover":
        return "hover " + where()
    return str(kind or "action")


def translate_delegate_action(action, obs):
    """Turn the model's action into a /api/act action, converting a 0-1000 x,y to pixels."""
    kind = action.get("action")
    screen = obs.get("screen") or {}
    w = screen.get("w") or 1280
    h = screen.get("h") or 800
    if kind == "open":
        return {"action": "navigate", "url": action.get("url", "")}
    if kind == "click":
        if isinstance(action.get("id"), int):
            return {"action": "click", "id": action["id"]}
        x, y = action.get("x"), action.get("y")
        if isinstance(x, (int, float)) and isinstance(y, (int, float)):
            return {"action": "click_xy",
                    "x": max(0, min(w - 1, round(x * w / 1000))),
                    "y": max(0, min(h - 1, round(y * h / 1000)))}
    if kind == "type":
        act = {"action": "type", "text": action.get("text", ""),
               "enter": bool(action.get("enter")), "clear": True}
        if isinstance(action.get("id"), int):
            act["id"] = action["id"]
        return act
    if kind == "key":
        return {"action": "key", "keys": action.get("keys", "")}
    if kind == "scroll":
        return {"action": "scroll", "direction": action.get("direction", "down"), "amount": 5}
    if kind == "hover":
        if isinstance(action.get("id"), int):
            return {"action": "hover", "id": action["id"]}
        x, y = action.get("x"), action.get("y")
        if isinstance(x, (int, float)) and isinstance(y, (int, float)):
            return {"action": "hover",
                    "x": max(0, min(w - 1, round(x * w / 1000))),
                    "y": max(0, min(h - 1, round(y * h / 1000)))}
    if kind == "back":
        return {"action": "back"}
    if kind == "wait":
        try:
            secs = int(action.get("seconds", 1))
        except (TypeError, ValueError):
            secs = 1
        return {"action": "wait", "seconds": max(0, min(10, secs))}
    raise AssertionError("not an act action: %r" % kind)


def delegate_act(api, session, token, action, caption_text):
    """Post one action to /api/act for the delegate loop. Return an exit code."""
    if health_user_control(api, session):
        if not wait_for_handback(api, session):
            return EXIT_USERCONTROL
    caption(api, session, caption_text, True, token)
    try:
        status, data = _request(api, session, "POST", "/api/act", body=action,
                                token=token, timeout=ACT_TIMEOUT)
    except ApiError as e:
        caption(api, session, "", False, token)
        print("desktop: %s" % e, file=sys.stderr)
        return EXIT_API
    caption(api, session, "", False, token)
    if status == 409:
        if not wait_for_handback(api, session):
            return EXIT_USERCONTROL
        caption(api, session, caption_text, True, token)
        try:
            status, data = _request(api, session, "POST", "/api/act", body=action,
                                    token=token, timeout=ACT_TIMEOUT)
        except ApiError as e:
            caption(api, session, "", False, token)
            print("desktop: %s" % e, file=sys.stderr)
            return EXIT_API
        caption(api, session, "", False, token)
        if status == 409:
            return EXIT_USERCONTROL
    if status == 400 or not isinstance(data, dict) or not data.get("ok", False):
        detail = _error_detail(data) or "action rejected"
        print("desktop: %s" % detail)
        return EXIT_API
    return EXIT_OK


